<%- include('../layout/header', { title: 'Paramètres Généraux - Gestion Scolaire RDC' }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="fas fa-cogs text-secondary me-2"></i> Configuration & Paramètres École</h3>
        <p class="text-muted small mb-0">Paramétrage de l'établissement, années scolaires, périodes et barème RDC</p>
    </div>
</div>

<div class="row g-4">
    <!-- Fiche Établissement -->
    <div class="col-lg-6">
        <div class="card border-0 rounded-4 shadow-sm p-4 h-100">
            <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                <i class="fas fa-school me-2"></i> Identité de l'Établissement
            </h5>
            <form action="/parametres" method="POST">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Nom Officiel du Complexe Scolaire</label>
                    <input type="text" class="form-control" value="Complexe Scolaire d'Excellence" readonly>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Code SECOPE / MinEdu</label>
                        <input type="text" class="form-control font-monospace" value="010892-KIN-2025" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Province / Sous-Division</label>
                        <input type="text" class="form-control" value="Kinshasa / Gombe" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Devise Monétaire Principale</label>
                        <input type="text" class="form-control" value="Franc Congolais (CDF)" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Régime Linguistique</label>
                        <input type="text" class="form-control" value="Français / Anglais" readonly>
                    </div>
                </div>
                <div class="alert alert-info py-2 small mb-0">
                    <i class="fas fa-info-circle me-1"></i> Structure conforme aux directives du Ministère de l'Éducation Nationale RDC.
                </div>
            </form>
        </div>
    </div>

    <!-- Périodes et Années Scolaires -->
    <div class="col-lg-6">
        <div class="card border-0 rounded-4 shadow-sm p-4 h-100">
            <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                <i class="fas fa-calendar-alt me-2"></i> Périodes Pédagogiques (2025-2026)
            </h5>
            <div class="list-group list-group-flush mb-3">
                <% periodes.forEach(function(p) { %>
                <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                    <div>
                        <strong><%= p.nom %></strong>
                        <small class="text-muted d-block"><%= p.semestre %></small>
                    </div>
                    <% if (p.active) { %>
                        <span class="badge bg-success rounded-pill px-3 py-1">En Cours</span>
                    <% } else { %>
                        <span class="badge bg-light text-muted border rounded-pill px-3 py-1">Clôturée</span>
                    <% } %>
                </div>
                <% }); %>
            </div>
            
            <h6 class="fw-bold text-dark mb-2">Options & Sections Actives :</h6>
            <div class="d-flex flex-wrap gap-2">
                <% options.forEach(function(o) { %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle p-2">
                        <%= o.nom %> (<%= o.code %>)
                    </span>
                <% }); %>
            </div>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
