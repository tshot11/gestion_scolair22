<%- include('../layout/header', { title: 'Cours et Matières - Gestion Scolaire RDC' }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="fas fa-book text-warning me-2"></i> Cours & Matières Pédagogiques</h3>
        <p class="text-muted small mb-0">Programme national, coefficients et affectations des cours aux enseignants</p>
    </div>
    <div>
        <a href="/cours/nouveau" class="btn btn-warning text-dark rounded-pill px-4 shadow-sm">
            <i class="fas fa-plus me-2"></i> Ajouter une matière
        </a>
    </div>
</div>

<div class="card border-0 rounded-4 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Nom du Cours</th>
                    <th>Coefficient</th>
                    <th>Enseignant Responsable</th>
                    <th>Option / Niveau</th>
                    <th>Description du Programme</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% cours.forEach(function(c) { 
                    const ens = enseignants.find(e => e.id === c.enseignant_id);
                    const opt = options.find(o => o.id === c.option_id);
                %>
                <tr>
                    <td><span class="badge bg-light text-dark border font-monospace fw-bold"><%= c.code %></span></td>
                    <td>
                        <strong class="text-dark"><%= c.nom %></strong>
                    </td>
                    <td><span class="badge bg-primary px-3 py-1">Coeff. <%= c.coefficient %></span></td>
                    <td>
                        <% if (ens) { %>
                            <div class="fw-semibold"><%= ens.nom %> <%= ens.prenom %></div>
                            <small class="text-muted"><%= ens.specialite %></small>
                        <% } else { %>
                            <span class="text-danger small">Non attribué</span>
                        <% } %>
                    </td>
                    <td>
                        <span class="badge bg-info-subtle text-info border border-info-subtle">
                            <%= opt ? opt.nom : 'Enseignement Général' %>
                        </span>
                    </td>
                    <td class="small text-muted" style="max-width: 250px;"><%= c.description %></td>
                    <td class="text-end">
                        <div class="btn-group">
                            <a href="/resultats/saisie?cours_id=<%= c.id %>" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Saisir des notes">
                                <i class="fas fa-pen-alt me-1"></i> Coter
                            </a>
                        </div>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../layout/footer') %>
