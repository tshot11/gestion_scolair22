<%- include('../layout/header', { title: 'Nouveau Cours - Gestion Scolaire RDC' }) %>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0"><i class="fas fa-book text-warning me-2"></i> Ajouter une Nouvelle Matière</h3>
            <a href="/cours" class="btn btn-outline-secondary rounded-pill px-3">Retour</a>
        </div>

        <div class="card border-0 rounded-4 shadow-sm p-4">
            <form action="/cours/nouveau" method="POST">
                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label class="form-label fw-semibold">Intitulé du Cours <span class="text-danger">*</span></label>
                        <input type="text" name="nom" class="form-control" placeholder="Ex: Mathématiques Générales" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Code Matière <span class="text-danger">*</span></label>
                        <input type="text" name="code" class="form-control" placeholder="Ex: MATH-601" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Coefficient <span class="text-danger">*</span></label>
                        <input type="number" name="coefficient" class="form-control" value="3" min="1" max="10" required>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-semibold">Enseignant titulaire du cours <span class="text-danger">*</span></label>
                        <select name="enseignant_id" class="form-select" required>
                            <% enseignants.forEach(function(e) { %>
                                <option value="<%= e.id %>"><%= e.nom %> <%= e.prenom %> (<%= e.specialite %>)</option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Niveau d'études</label>
                        <select name="niveau_id" class="form-select">
                            <% niveaux.forEach(function(n) { %>
                                <option value="<%= n.id %>"><%= n.nom %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Option / Section</label>
                        <select name="option_id" class="form-select">
                            <option value="">Tronc commun / Général</option>
                            <% options.forEach(function(o) { %>
                                <option value="<%= o.id %>"><%= o.nom %> (<%= o.code %>)</option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Description sommaire du programme</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Objectifs et chapitres couverts"></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a href="/cours" class="btn btn-light rounded-pill px-4">Annuler</a>
                    <button type="submit" class="btn btn-warning text-dark rounded-pill px-5 fw-semibold">Enregistrer le cours</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
