<%- include('../layout/header', { title: 'Nouveau Message - Gestion Scolaire RDC' }) %>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0"><i class="fas fa-paper-plane text-primary me-2"></i> Diffuser un Message / Annonce</h3>
            <a href="/communication" class="btn btn-outline-secondary rounded-pill px-3">Retour</a>
        </div>

        <div class="card border-0 rounded-4 shadow-sm p-4">
            <form action="/communication/nouveau" method="POST">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Objet / Titre de l'annonce <span class="text-danger">*</span></label>
                    <input type="text" name="sujet" class="form-control" placeholder="Ex: Réunion des parents d'élèves - Samedi 22" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Groupe de Destinataires <span class="text-danger">*</span></label>
                    <select name="destinataire_role" class="form-select" required>
                        <option value="Tous les Parents & Tuteurs">👨‍👩‍👧‍👦 Tous les Parents & Tuteurs</option>
                        <option value="Corps Enseignant">👨‍🏫 Corps Enseignant</option>
                        <option value="Personnel Administratif">💼 Personnel Administratif</option>
                        <option value="Tous les Utilisateurs">🌐 Toute la communauté scolaire</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Corps du Message <span class="text-danger">*</span></label>
                    <textarea name="contenu" class="form-control" rows="5" placeholder="Rédigez ici le communiqué..." required></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a href="/communication" class="btn btn-light rounded-pill px-4">Annuler</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-semibold">Diffuser le message</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
