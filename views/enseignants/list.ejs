<%- include('../layout/header', { title: 'Corps Enseignant - Gestion Scolaire RDC' }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="fas fa-chalkboard-teacher text-success me-2"></i> Corps Enseignant</h3>
        <p class="text-muted small mb-0">Gestion des professeurs, instituteurs, titulaires de classe et affectations</p>
    </div>
    <div>
        <a href="/enseignants/nouveau" class="btn btn-success rounded-pill px-4 shadow-sm">
            <i class="fas fa-user-plus me-2"></i> Ajouter un enseignant
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <% enseignants.forEach(function(ens) { 
        const coursList = cours.filter(c => c.enseignant_id === ens.id);
    %>
    <div class="col-xl-4 col-md-6">
        <div class="card border-0 rounded-4 shadow-sm p-4 h-100 position-relative">
            <div class="d-flex align-items-center mb-3">
                <% if (ens.photo) { %>
                    <img src="<%= ens.photo %>" class="rounded-circle me-3 shadow-sm" style="width: 60px; height: 60px; object-fit: cover;" alt="Photo">
                <% } else { %>
                    <div class="avatar-placeholder me-3 bg-success bg-opacity-10 text-success fw-bold" style="width: 60px; height: 60px; font-size: 1.2rem;">
                        <%= ens.nom[0] %><%= ens.prenom[0] %>
                    </div>
                <% } %>
                <div>
                    <h5 class="fw-bold mb-0 text-dark"><%= ens.nom %> <%= ens.prenom %></h5>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill font-monospace small"><%= ens.matricule %></span>
                </div>
            </div>

            <div class="mb-3 small">
                <div class="text-muted mb-1"><i class="fas fa-briefcase text-success me-2"></i><strong>Spécialité :</strong> <%= ens.specialite %></div>
                <div class="text-muted mb-1"><i class="fas fa-phone text-success me-2"></i><%= ens.telephone %></div>
                <div class="text-muted mb-1"><i class="fas fa-envelope text-success me-2"></i><%= ens.email %></div>
            </div>

            <div class="border-top pt-3 mt-auto d-flex justify-content-between align-items-center">
                <span class="badge bg-light text-dark border"><%= coursList.length %> Matière(s) dispensée(s)</span>
                <div class="btn-group">
                    <a href="/enseignants/<%= ens.id %>" class="btn btn-sm btn-outline-success rounded-pill px-3">
                        <i class="fas fa-eye me-1"></i> Fiche
                    </a>
                </div>
            </div>
        </div>
    </div>
    <% }); %>
</div>

<%- include('../layout/footer') %>
