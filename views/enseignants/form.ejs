<%- include('../layout/header', { title: (enseignant ? 'Modifier enseignant' : 'Nouvel enseignant') + ' - Gestion Scolaire RDC' }) %>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-0">
                    <i class="fas fa-chalkboard-teacher text-success me-2"></i>
                    <%= enseignant ? 'Modifier l’Enseignant' : 'Enregistrer un Enseignant' %>
                </h3>
            </div>
            <a href="/enseignants" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="fas fa-arrow-left me-1"></i> Annuler
            </a>
        </div>

        <div class="card border-0 rounded-4 shadow-sm p-4">
            <form action="<%= enseignant ? '/enseignants/' + enseignant.id + '/modifier' : '/enseignants/nouveau' %>" method="POST" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Nom <span class="text-danger">*</span></label>
                        <input type="text" name="nom" class="form-control" value="<%= enseignant ? enseignant.nom : '' %>" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Prénom <span class="text-danger">*</span></label>
                        <input type="text" name="prenom" class="form-control" value="<%= enseignant ? enseignant.prenom : '' %>" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Sexe <span class="text-danger">*</span></label>
                        <select name="sexe" class="form-select" required>
                            <option value="M" <%= enseignant && enseignant.sexe === 'M' ? 'selected' : '' %>>Masculin</option>
                            <option value="F" <%= enseignant && enseignant.sexe === 'F' ? 'selected' : '' %>>Féminin</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Spécialité / Matière principale</label>
                        <input type="text" name="specialite" class="form-control" value="<%= enseignant ? enseignant.specialite : '' %>" placeholder="Ex: Mathématiques">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Statut</label>
                        <select name="statut" class="form-select">
                            <option value="titulaire" <%= enseignant && enseignant.statut === 'titulaire' ? 'selected' : '' %>>Titulaire</option>
                            <option value="professeur" <%= enseignant && enseignant.statut === 'professeur' ? 'selected' : '' %>>Professeur par heure</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Téléphone</label>
                        <input type="text" name="telephone" class="form-control" value="<%= enseignant ? enseignant.telephone : '' %>" placeholder="+243 ...">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" name="email" class="form-control" value="<%= enseignant ? enseignant.email : '' %>" placeholder="enseignant@ecole.cd">
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Adresse de résidence</label>
                        <input type="text" name="adresse" class="form-control" value="<%= enseignant ? enseignant.adresse : '' %>">
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 border-top pt-4 mt-4">
                    <a href="/enseignants" class="btn btn-light rounded-pill px-4">Annuler</a>
                    <button type="submit" class="btn btn-success rounded-pill px-5 shadow-sm fw-semibold">
                        <i class="fas fa-save me-2"></i> Enregistrer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
