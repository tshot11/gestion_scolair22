<%- include('../layout/header', { title: 'Charges et Dépenses - Gestion Scolaire RDC' }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="fas fa-money-bill-wave text-danger me-2"></i> Charges & Dépenses de l'Établissement</h3>
        <p class="text-muted small mb-0">Suivi des décaissements, achats de fournitures, maintenance et factures</p>
    </div>
    <div>
        <button class="btn btn-danger rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#depenseModal">
            <i class="fas fa-plus me-2"></i> Enregistrer une dépense
        </button>
    </div>
</div>

<div class="card border-0 rounded-4 shadow-sm p-4">
    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Réf. Pièce</th>
                    <th>Motif / Description de la dépense</th>
                    <th>Bénéficiaire / Fournisseur</th>
                    <th>Montant Décaissé</th>
                    <th>Date</th>
                    <th>Approuvé par</th>
                </tr>
            </thead>
            <tbody>
                <% depenses.forEach(function(d) { %>
                <tr>
                    <td><span class="badge bg-light text-dark border font-monospace"><%= d.reference %></span></td>
                    <td><strong><%= d.description %></strong></td>
                    <td><%= d.beneficiaire %></td>
                    <td class="fw-bold text-danger fs-6">-<%= Number(d.montant).toLocaleString('fr-FR') %> CDF</td>
                    <td class="small text-muted"><%= d.date %></td>
                    <td><span class="badge bg-success-subtle text-success border border-success-subtle">Directeur Général</span></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Ajout Dépense -->
<div class="modal fade" id="depenseModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-minus-circle text-danger me-2"></i> Nouvelle Dépense</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/finance/depenses" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Motif de la dépense <span class="text-danger">*</span></label>
                        <input type="text" name="description" class="form-control" placeholder="Ex: Achat craies et papier duplicateur" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Bénéficiaire / Fournisseur <span class="text-danger">*</span></label>
                        <input type="text" name="beneficiaire" class="form-control" placeholder="Ex: Papeterie Centrale" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Montant en CDF <span class="text-danger">*</span></label>
                        <input type="number" name="montant" class="form-control fw-bold text-danger" placeholder="100000" required>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Valider le décaissement</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
