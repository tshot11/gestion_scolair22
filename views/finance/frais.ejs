<%- include('../layout/header', { title: 'Barème des Frais Scolaires - Gestion Scolaire RDC' }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="fas fa-tags text-primary me-2"></i> Nomenclature des Frais Scolaires</h3>
        <p class="text-muted small mb-0">Définition de la grille tarifaire (Minerval, inscription, frais d'État et activités)</p>
    </div>
</div>

<div class="card border-0 rounded-4 shadow-sm p-4">
    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Intitulé des Frais</th>
                    <th>Catégorie</th>
                    <th>Montant Fixé</th>
                    <th>Devise</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                <% frais.forEach(function(f) { %>
                <tr>
                    <td><strong><%= f.nom %></strong></td>
                    <td><span class="badge bg-light text-dark border"><%= f.type %></span></td>
                    <td class="fw-bold fs-6 text-primary"><%= Number(f.montant).toLocaleString('fr-FR') %></td>
                    <td><span class="badge bg-dark"><%= f.devise %></span></td>
                    <td><span class="badge bg-success">Actif pour 2025-2026</span></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../layout/footer') %>
