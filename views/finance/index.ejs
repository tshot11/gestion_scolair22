<%- include('../layout/header', { title: 'Trésorerie & Finances - Gestion Scolaire RDC' }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge badge-figma-amber"><i class="fas fa-wallet me-1"></i> Module Financier</span>
            <span class="badge bg-light text-muted border">Devise : Franc Congolais (CDF)</span>
        </div>
        <h2 class="fw-bold mb-0">Gestion Financière & Recouvrement</h2>
    </div>
    <div class="d-flex gap-2">
        <a href="/finance/paiements/nouveau" class="btn btn-success" id="btn-nouveau-paiement">
            <i class="fas fa-plus-circle me-1"></i> Encaisser un paiement
        </a>
        <a href="/finance/depenses" class="btn btn-secondary">
            <i class="fas fa-file-invoice-dollar me-1"></i> Registre des dépenses
        </a>
    </div>
</div>

<!-- 3 Modern Financial Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card-figma h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="stat-icon-wrapper" style="background: var(--figma-emerald-light); color: var(--figma-emerald);">
                    <i class="fas fa-arrow-down"></i>
                </div>
                <span class="badge badge-figma-emerald"><i class="fas fa-check-circle me-1"></i> Encaissé</span>
            </div>
            <div class="text-muted small fw-bold text-uppercase">Total Recouvrement (CDF)</div>
            <h2 class="fw-bold my-2 text-dark font-mono"><%= stats.total_recouvrement.toLocaleString('fr-FR') %> <span class="fs-6 text-muted font-sans">CDF</span></h2>
            <div class="small text-muted pt-2 border-top">Montant cumulé des frais payés</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card-figma h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="stat-icon-wrapper" style="background: var(--figma-rose-light); color: var(--figma-rose);">
                    <i class="fas fa-arrow-up"></i>
                </div>
                <span class="badge badge-figma-rose"><i class="fas fa-receipt me-1"></i> Dépensé</span>
            </div>
            <div class="text-muted small fw-bold text-uppercase">Total Dépenses Engagées</div>
            <h2 class="fw-bold my-2 text-dark font-mono"><%= stats.total_depenses.toLocaleString('fr-FR') %> <span class="fs-6 text-muted font-sans">CDF</span></h2>
            <div class="small text-muted pt-2 border-top">Fonctionnement & fournitures école</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card-figma h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="stat-icon-wrapper" style="background: var(--figma-blue-light); color: var(--figma-blue);">
                    <i class="fas fa-vault"></i>
                </div>
                <span class="badge badge-figma-blue"><i class="fas fa-shield-alt me-1"></i> Disponible</span>
            </div>
            <div class="text-muted small fw-bold text-uppercase">Solde Net en Caisse</div>
            <h2 class="fw-bold my-2 text-primary font-mono"><%= stats.solde_caisse.toLocaleString('fr-FR') %> <span class="fs-6 text-muted font-sans">CDF</span></h2>
            <div class="small text-muted pt-2 border-top">Trésorerie nette disponible</div>
        </div>
    </div>
</div>

<!-- Recent Transactions Table -->
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold text-dark"><i class="fas fa-history text-primary me-2"></i> Derniers Paiements Encaissés</span>
        <a href="/finance/paiements" class="btn btn-sm btn-secondary">Tous les encaissements &rarr;</a>
    </div>
    <div class="table-responsive">
        <table class="table table-custom mb-0 align-middle">
            <thead>
                <tr>
                    <th>Réf. Quittance</th>
                    <th>Élève Payeur</th>
                    <th>Type de Frais</th>
                    <th>Montant Payé</th>
                    <th>Date Paiement</th>
                    <th>Mode</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% paiements.forEach(function(p) { 
                    const el = eleves.find(e => e.id === p.eleve_id);
                    const f = frais.find(fr => fr.id === p.frais_id);
                %>
                <tr>
                    <td><span class="badge bg-light text-dark border font-mono"><%= p.reference %></span></td>
                    <td>
                        <div class="fw-bold text-dark"><%= el ? el.nom + ' ' + el.prenom : 'Élève inconnu' %></div>
                        <small class="text-muted font-mono"><%= el ? el.matricule : '' %></small>
                    </td>
                    <td><span class="fw-medium text-dark"><%= f ? f.nom : 'Frais' %></span></td>
                    <td><strong class="text-success font-mono">+<%= Number(p.montant_paye).toLocaleString('fr-FR') %> CDF</strong></td>
                    <td><span class="small text-muted"><%= p.date_paiement %></span></td>
                    <td><span class="badge badge-figma-blue"><%= p.mode %></span></td>
                    <td class="text-end">
                        <a href="/finance/recu/<%= p.id %>" class="btn btn-sm btn-primary">
                            <i class="fas fa-receipt me-1"></i> Quittance
                        </a>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../layout/footer') %>
