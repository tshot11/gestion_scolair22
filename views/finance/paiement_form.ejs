<%- include('../layout/header', { title: 'Encaisser un Paiement - Gestion Scolaire RDC' }) %>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0"><i class="fas fa-hand-holding-usd text-success me-2"></i> Encaisser un Frais Scolaire</h3>
            <a href="/finance/paiements" class="btn btn-outline-secondary rounded-pill px-3">Retour au journal</a>
        </div>

        <div class="card border-0 rounded-4 shadow-sm p-4">
            <form action="/finance/paiements/nouveau" method="POST">
                <div class="row g-3 mb-3">
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Sélectionner l'Élève <span class="text-danger">*</span></label>
                        <select name="eleve_id" class="form-select" required>
                            <% eleves.forEach(function(e) { %>
                                <option value="<%= e.id %>" <%= selectedEleveId == e.id ? 'selected' : '' %>><%= e.nom %> <%= e.prenom %> (<%= e.matricule %>)</option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Nature du Frais <span class="text-danger">*</span></label>
                        <select name="frais_id" class="form-select" id="fraisSelect" required>
                            <% frais.forEach(function(f) { %>
                                <option value="<%= f.id %>" data-montant="<%= f.montant %>"><%= f.nom %> - <%= Number(f.montant).toLocaleString('fr-FR') %> <%= f.devise %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Montant Versé (CDF) <span class="text-danger">*</span></label>
                        <input type="number" name="montant_paye" id="montantInput" class="form-control fw-bold text-success" value="<%= frais.length > 0 ? frais[0].montant : 150000 %>" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Mode de Paiement <span class="text-danger">*</span></label>
                        <select name="mode" class="form-select" required>
                            <option value="Espèces / Caisse">💵 Espèces / Caisse Principale</option>
                            <option value="Mobile Money (M-Pesa)">📱 Mobile Money (Vodacom M-Pesa)</option>
                            <option value="Mobile Money (Orange Money)">📱 Mobile Money (Orange Money)</option>
                            <option value="Mobile Money (Airtel Money)">📱 Mobile Money (Airtel Money)</option>
                            <option value="Virement Bancaire (Rawbank)">🏦 Virement Bancaire (Rawbank)</option>
                            <option value="Virement Bancaire (Equity BCDC)">🏦 Virement Bancaire (Equity BCDC)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Numéro de Transaction / Réf. Bancaire</label>
                        <input type="text" name="ref_banque" class="form-control font-monospace" placeholder="Optionnel">
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a href="/finance" class="btn btn-light rounded-pill px-4">Annuler</a>
                    <button type="submit" class="btn btn-success rounded-pill px-5 fw-bold">
                        <i class="fas fa-check-circle me-1"></i> Valider et Générer la Quittance
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../layout/footer', {
    extraJs: `
    <script>
        const fSelect = document.getElementById('fraisSelect');
        const mInput = document.getElementById('montantInput');
        if (fSelect && mInput) {
            fSelect.addEventListener('change', function() {
                const opt = this.options[this.selectedIndex];
                const montant = opt.getAttribute('data-montant');
                if (montant) mInput.value = montant;
            });
        }
    </script>
    `
}) %>
