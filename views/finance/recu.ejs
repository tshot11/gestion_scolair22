<%- include('../layout/header', { title: 'Quittance de Paiement - ' + paiement.reference }) %>

<div class="d-flex justify-content-between align-items-center mb-4 d-print-none flex-wrap gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/finance/paiements" class="text-decoration-none">Finances</a></li>
                <li class="breadcrumb-item active">Quittance <%= paiement.reference %></li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0">Quittance Officielle de Caisse</h3>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-success rounded-pill px-4 shadow-sm" onclick="window.print()">
            <i class="fas fa-print me-2"></i> Imprimer le Reçu
        </button>
        <a href="/finance/paiements" class="btn btn-light rounded-pill px-3">
            <i class="fas fa-arrow-left me-1"></i> Retour
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4 p-md-5 bg-white rounded-4" style="border: 2px dashed #cbd5e1 !important;">
            <!-- En-tête -->
            <div class="text-center border-bottom pb-3 mb-3">
                <i class="fas fa-school fa-2x text-primary mb-2"></i>
                <h4 class="fw-bold text-uppercase mb-0">COMPLEXE SCOLAIRE D'EXCELLENCE</h4>
                <p class="small text-muted mb-1">Kinshasa - Rép. Démocratique du Congo &bull; Tél: +243 81 234 5678</p>
                <div class="badge bg-dark px-3 py-1 fs-6 font-monospace">QUITTANCE DE CAISSE N° <%= paiement.reference %></div>
            </div>

            <!-- Détails de la quittance -->
            <div class="row g-3 mb-4">
                <div class="col-6">
                    <small class="text-muted text-uppercase fw-bold d-block">Reçu de l'Élève :</small>
                    <h5 class="fw-bold text-dark mb-0"><%= eleve ? eleve.nom + ' ' + eleve.prenom : 'Élève' %></h5>
                    <div class="small text-muted">Matricule : <strong><%= eleve ? eleve.matricule : '' %></strong></div>
                    <div class="small text-muted">Classe : <strong><%= classe ? classe.nom : 'Classe' %></strong></div>
                </div>
                <div class="col-6 text-end">
                    <small class="text-muted text-uppercase fw-bold d-block">Date d'encaissement :</small>
                    <h6 class="fw-bold text-dark mb-1"><%= paiement.date_paiement %></h6>
                    <div class="small text-muted">Mode : <span class="badge bg-light text-dark border"><%= paiement.mode || 'Espèces' %></span></div>
                    <div class="small text-muted">Année : <strong>2025-2026</strong></div>
                </div>
            </div>

            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Désignation des Frais</th>
                            <th class="text-end">Montant Total</th>
                            <th class="text-end">Montant Payé</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <strong><%= frais ? frais.nom : 'Frais Scolaires' %></strong>
                                <div class="small text-muted"><%= frais ? frais.type : 'Scolarité' %></div>
                            </td>
                            <td class="text-end font-monospace"><%= frais ? Number(frais.montant).toLocaleString('fr-FR') : 0 %> CDF</td>
                            <td class="text-end font-monospace fw-bold text-success fs-5"><%= Number(paiement.montant_paye).toLocaleString('fr-FR') %> CDF</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="p-3 bg-light rounded-3 mb-4 text-center">
                <small class="text-muted">Arrêté la présente quittance à la somme de :</small>
                <div class="fw-bold text-dark fs-6 mt-1">
                    <em>Cent cinquante mille Francs Congolais</em>
                </div>
            </div>

            <div class="row pt-3 border-top text-center">
                <div class="col-6">
                    <small class="text-muted fw-bold d-block mb-4">Le Payeur (Parent/Élève)</small>
                    <p class="text-muted small fst-italic">(Signature)</p>
                </div>
                <div class="col-6">
                    <small class="text-muted fw-bold d-block mb-4">Le Caissier / Comptable</small>
                    <p class="fw-bold mb-0">Caisse Centrale</p>
                    <small class="text-success"><i class="fas fa-check-circle me-1"></i> PAYÉ & VALIDÉ</small>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
