<%- include('../layout/header', { title: 'Pointage des Présences - Gestion Scolaire RDC' }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="fas fa-calendar-check text-danger me-2"></i> Pointage Journalier des Présences</h3>
        <p class="text-muted small mb-0">Appel nominal, pointage des arrivées, retards, absences justifiées et exclusions</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-danger px-3 py-2 rounded-pill fs-6">
            <i class="fas fa-calendar-day me-1"></i> Date : <strong>20 Août 2026</strong>
        </span>
    </div>
</div>

<!-- Résumé Synthétique du Pointage -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 rounded-4 shadow-sm p-3 bg-success text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="small text-white-50 text-uppercase fw-bold">Présents</span>
                    <h3 class="fw-bold mb-0"><%= stats.presentCount %> Élèves</h3>
                </div>
                <i class="fas fa-user-check fa-2x opacity-75"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 rounded-4 shadow-sm p-3 bg-danger text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="small text-white-50 text-uppercase fw-bold">Absents</span>
                    <h3 class="fw-bold mb-0"><%= stats.absentCount %> Élèves</h3>
                </div>
                <i class="fas fa-user-times fa-2x opacity-75"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 rounded-4 shadow-sm p-3 bg-warning text-dark">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="small text-dark-50 text-uppercase fw-bold">En Retard</span>
                    <h3 class="fw-bold mb-0"><%= stats.retardCount %> Élèves</h3>
                </div>
                <i class="fas fa-user-clock fa-2x opacity-75"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 rounded-4 shadow-sm p-3 bg-info text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="small text-white-50 text-uppercase fw-bold">Malades / Justifiés</span>
                    <h3 class="fw-bold mb-0"><%= stats.maladeCount %> Élèves</h3>
                </div>
                <i class="fas fa-heartbeat fa-2x opacity-75"></i>
            </div>
        </div>
    </div>
</div>

<!-- Fiche d'appel nominatif -->
<div class="card border-0 rounded-4 shadow-sm p-4">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h5 class="fw-bold text-dark mb-0">
            <i class="fas fa-list-ol text-primary me-2"></i> Appel de la journée (Toutes classes)
        </h5>
        <span class="text-muted small">Cochez ou modifiez le statut pour chaque élève ci-dessous :</span>
    </div>

    <form action="/presences/pointage" method="POST">
        <div class="table-responsive">
            <table class="table table-hover table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th>Élève</th>
                        <th>Matricule</th>
                        <th>Classe</th>
                        <th>Statut de Présence</th>
                        <th>Heure d'arrivée</th>
                        <th>Motif / Justification</th>
                    </tr>
                </thead>
                <tbody>
                    <% eleves.forEach(function(el) { 
                        const cl = classes.find(c => c.id === el.classe_id);
                        const pt = pointages.find(p => p.eleve_id === el.id) || { statut: 'present', heure_arrivee: '07:30', motif: '' };
                    %>
                    <tr>
                        <td>
                            <input type="hidden" name="eleve_ids[]" value="<%= el.id %>">
                            <div class="d-flex align-items-center">
                                <% if (el.photo) { %>
                                    <img src="<%= el.photo %>" class="student-avatar me-2" alt="Photo">
                                <% } else { %>
                                    <div class="avatar-placeholder me-2"><%= el.nom[0] %><%= el.prenom[0] %></div>
                                <% } %>
                                <div>
                                    <strong><%= el.nom %> <%= el.prenom %></strong>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-light text-dark border font-monospace"><%= el.matricule %></span></td>
                        <td><span class="fw-semibold"><%= cl ? cl.nom : 'Classe' %></span></td>
                        <td>
                            <select name="statuts_<%= el.id %>" class="form-select form-select-sm fw-semibold <%= pt.statut === 'present' ? 'border-success text-success' : pt.statut === 'absent' ? 'border-danger text-danger' : 'border-warning text-dark' %>">
                                <option value="present" <%= pt.statut === 'present' ? 'selected' : '' %>>🟢 Présent(e)</option>
                                <option value="absent" <%= pt.statut === 'absent' ? 'selected' : '' %>>🔴 Absent(e)</option>
                                <option value="retard" <%= pt.statut === 'retard' ? 'selected' : '' %>>🟡 En Retard</option>
                                <option value="malade" <%= pt.statut === 'malade' ? 'selected' : '' %>>🔵 Malade / Dispensé</option>
                                <option value="autorise" <%= pt.statut === 'autorise' ? 'selected' : '' %>>⚪ Absence Autorisée</option>
                            </select>
                        </td>
                        <td>
                            <input type="time" name="heures_<%= el.id %>" class="form-control form-control-sm" value="<%= pt.heure_arrivee || '07:30' %>">
                        </td>
                        <td>
                            <input type="text" name="motifs_<%= el.id %>" class="form-control form-control-sm" placeholder="Observation éventuelle" value="<%= pt.motif || '' %>">
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-3">
            <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm fw-bold">
                <i class="fas fa-save me-2"></i> Enregistrer le pointage du jour
            </button>
        </div>
    </form>
</div>

<%- include('../layout/footer') %>
