<%- include('../layout/header', { title: 'Bulletin Scolaire - ' + eleve.nom + ' ' + eleve.prenom }) %>

<div class="d-flex justify-content-between align-items-center mb-4 d-print-none flex-wrap gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/resultats" class="text-decoration-none">Résultats</a></li>
                <li class="breadcrumb-item active">Bulletin Scolaire</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0">Bulletin Officiel de Délibération</h3>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="window.print()">
            <i class="fas fa-print me-2"></i> Imprimer le Bulletin Scolaire
        </button>
        <a href="/resultats" class="btn btn-light rounded-pill px-3">
            <i class="fas fa-arrow-left me-1"></i> Retour
        </a>
    </div>
</div>

<!-- Feuille Officielle de Bulletin (Format Imprimable) -->
<div class="card border-0 shadow-sm p-4 p-md-5 bg-white rounded-4" id="printableBulletin">
    
    <!-- En-tête officiel RDC -->
    <div class="text-center border-bottom pb-4 mb-4">
        <div class="row align-items-center">
            <div class="col-3 text-start">
                <h6 class="fw-bold text-uppercase mb-0 small">RÉPUBLIQUE DÉMOCRATIQUE DU CONGO</h6>
                <p class="small text-muted mb-0">Ministère de l'Éducation Nationale et Nouvelle Citoyenneté</p>
                <p class="small text-muted mb-0">Sous-Division Provinciale de Kinshasa</p>
            </div>
            <div class="col-6 text-center">
                <i class="fas fa-school fa-3x text-primary mb-2"></i>
                <h4 class="fw-bold text-uppercase mb-1 tracking-wide">COMPLEXE SCOLAIRE D'EXCELLENCE</h4>
                <div class="badge bg-primary px-3 py-1 fs-6">BULLETIN SCOLAIRE - ANNEE 2025-2026</div>
            </div>
            <div class="col-3 text-end">
                <div class="p-2 border rounded text-center d-inline-block">
                    <small class="text-muted d-block">ID ÉLÈVE</small>
                    <strong class="font-monospace"><%= eleve.matricule %></strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Informations Élève -->
    <div class="bg-light p-3 rounded-3 mb-4 border">
        <div class="row g-2">
            <div class="col-md-6">
                <strong>Nom & Prénom :</strong> <span class="text-uppercase fw-bold"><%= eleve.nom %></span> <%= eleve.prenom %>
            </div>
            <div class="col-md-3">
                <strong>Sexe :</strong> <%= eleve.sexe === 'M' ? 'Masculin' : 'Féminin' %>
            </div>
            <div class="col-md-3">
                <strong>Classe :</strong> <span class="fw-bold text-primary"><%= eleve.classe ? eleve.classe.nom : 'Classe' %></span>
            </div>
            <div class="col-md-6">
                <strong>Né(e) le :</strong> <%= eleve.date_naissance %> à <%= eleve.lieu_naissance %>
            </div>
            <div class="col-md-6">
                <strong>Période Évaluée :</strong> <span class="badge bg-dark">3ème Période (Mars - Mai 2026)</span>
            </div>
        </div>
    </div>

    <!-- Tableau des Cotes -->
    <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle text-center mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="text-start" style="width: 35%;">Matières / Disciplines</th>
                    <th>Max. Période</th>
                    <th>Coeff.</th>
                    <th>Cote Obtenue /20</th>
                    <th>Total Pondéré</th>
                    <th class="text-start">Appréciation du Professeur</th>
                </tr>
            </thead>
            <tbody>
                <% eleve.resultats.forEach(function(r) { %>
                <tr>
                    <td class="text-start fw-bold">
                        <%= r.cours_nom %>
                        <div class="small text-muted font-monospace"><%= r.cours_code %></div>
                    </td>
                    <td>20</td>
                    <td><span class="badge bg-light text-dark border">x<%= r.coefficient %></span></td>
                    <td class="fw-bold fs-6 <%= r.note >= 10 ? 'text-success' : 'text-danger' %>">
                        <%= r.note %>
                    </td>
                    <td class="fw-bold bg-light">
                        <%= (r.note * r.coefficient).toFixed(1) %>
                    </td>
                    <td class="text-start small text-muted"><%= r.appreciation || 'Travail régulier' %></td>
                </tr>
                <% }); %>
            </tbody>
            <tfoot class="table-light">
                <tr class="fw-bold fs-6">
                    <td class="text-start">TOTAL GÉNÉRAL :</td>
                    <td><%= eleve.totalCoeff * 20 %></td>
                    <td><%= eleve.totalCoeff %></td>
                    <td class="text-primary"><%= eleve.moyenne %> / 20</td>
                    <td class="text-primary"><%= eleve.totalPoints %></td>
                    <td class="text-start text-success">Mention : <%= eleve.mention %></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Synthèse & Conduite -->
    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="p-3 border rounded-3 bg-light text-center">
                <small class="text-muted text-uppercase fw-bold d-block mb-1">Pourcentage Obtenu</small>
                <h3 class="fw-bold mb-0 text-primary"><%= eleve.pourcentage %> %</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 border rounded-3 bg-light text-center">
                <small class="text-muted text-uppercase fw-bold d-block mb-1">Rang dans la classe</small>
                <h3 class="fw-bold mb-0 text-success">1<small>er</small> <span class="fs-6 text-muted">/ <%= elevesCount %> élèves</span></h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 border rounded-3 bg-light text-center">
                <small class="text-muted text-uppercase fw-bold d-block mb-1">Application & Conduite</small>
                <h4 class="fw-bold mb-0 text-dark">Très Bonne (TB)</h4>
            </div>
        </div>
    </div>

    <!-- Signatures -->
    <div class="row mt-4 pt-4 border-top text-center">
        <div class="col-4">
            <p class="mb-5 small text-muted fw-bold">LE TITULAIRE DE CLASSE</p>
            <p class="fw-bold mb-0">Prof. Jean-Pierre MUKENDI</p>
        </div>
        <div class="col-4">
            <p class="mb-5 small text-muted fw-bold">LE PARENT / TUTEUR</p>
            <p class="text-muted small fst-italic">(Signature & Date)</p>
        </div>
        <div class="col-4">
            <p class="mb-5 small text-muted fw-bold">LE PRÉFET DES ÉTUDES</p>
            <p class="fw-bold mb-0">Dieudonné TSHILOMBO</p>
            <small class="text-muted">Sceau de l'Établissement</small>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
