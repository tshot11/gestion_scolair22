<%- include('../layout/header', { title: 'Résultats & Bulletins - Gestion Scolaire RDC' }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="fas fa-file-invoice text-success me-2"></i> Résultats Académiques & Bulletins</h3>
        <p class="text-muted small mb-0">Délibérations, relevés périodiques de cotes et impression des bulletins officiels</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/resultats/saisie" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="fas fa-pen-fancy me-2"></i> Saisir de nouvelles cotes
        </a>
    </div>
</div>

<div class="card border-0 rounded-4 shadow-sm p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h5 class="fw-bold text-dark mb-0">Palmarès & Délibération : <strong>3ème Période 2025-2026</strong></h5>
        <span class="badge bg-success px-3 py-2 rounded-pill">Période Clôturée</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Rang</th>
                    <th>Élève</th>
                    <th>Matricule</th>
                    <th>Classe</th>
                    <th>Moyenne /20</th>
                    <th>Pourcentage</th>
                    <th>Mention</th>
                    <th class="text-end">Bulletin</th>
                </tr>
            </thead>
            <tbody>
                <% eleves.forEach(function(el, idx) { 
                    const detail = getEleveDetail(el.id);
                %>
                <tr>
                    <td>
                        <span class="badge <%= idx === 0 ? 'bg-warning text-dark' : idx === 1 ? 'bg-secondary' : 'bg-light text-dark border' %> fs-6 rounded-circle" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                            <%= idx + 1 %>
                        </span>
                    </td>
                    <td>
                        <div class="d-flex align-items-center">
                            <% if (el.photo) { %>
                                <img src="<%= el.photo %>" class="student-avatar me-2" alt="Photo">
                            <% } else { %>
                                <div class="avatar-placeholder me-2"><%= el.nom[0] %><%= el.prenom[0] %></div>
                            <% } %>
                            <div>
                                <a href="/eleves/<%= el.id %>" class="fw-bold text-dark text-decoration-none">
                                    <%= el.nom %> <%= el.prenom %>
                                </a>
                            </div>
                        </div>
                    </td>
                    <td><span class="badge bg-light text-dark border font-monospace"><%= el.matricule %></span></td>
                    <td><%= detail.classe ? detail.classe.nom : 'Classe' %></td>
                    <td><strong class="text-primary fs-6"><%= detail.moyenne %></strong> / 20</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold <%= Number(detail.pourcentage) >= 60 ? 'text-success' : 'text-danger' %>">
                                <%= detail.pourcentage %>%
                            </span>
                            <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                <div class="progress-bar <%= Number(detail.pourcentage) >= 60 ? 'bg-success' : 'bg-danger' %>" style="width: <%= detail.pourcentage %>%"></div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="badge <%= Number(detail.pourcentage) >= 70 ? 'bg-success-subtle text-success' : Number(detail.pourcentage) >= 50 ? 'bg-info-subtle text-info' : 'bg-danger-subtle text-danger' %> border">
                            <%= detail.mention %>
                        </span>
                    </td>
                    <td class="text-end">
                        <a href="/resultats/bulletin/<%= el.id %>" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm">
                            <i class="fas fa-print me-1"></i> Bulletin
                        </a>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../layout/footer') %>
