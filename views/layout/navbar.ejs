<header class="modern-navbar d-flex justify-content-between align-items-center">
    <!-- Left Section: Mobile Toggle & Quick Search Trigger -->
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-sm btn-secondary d-lg-none rounded-circle p-2" id="sidebarToggle" type="button" style="width: 36px; height: 36px;">
            <i class="fas fa-bars"></i>
        </button>

        <!-- Modern Command Palette / Search Trigger Button -->
        <button class="figma-search-trigger" id="openCommandPalette" type="button" title="Ouvrir la recherche globale (Ctrl+K)">
            <i class="fas fa-search text-muted"></i>
            <span>Rechercher élève, classe, reçu...</span>
            <span class="kbd-badge ms-auto">⌘K</span>
        </button>

        <!-- Academic Year Capsule -->
        <div class="d-none d-xl-flex align-items-center gap-2 px-3 py-1 bg-light rounded-pill border">
            <span class="badge-dot bg-success animate-pulse"></span>
            <span class="small fw-semibold text-secondary" style="font-size: 0.8rem;">
                Année Scolaire <strong class="text-dark">2025-2026</strong> &bull; 3<sup>e</sup> Période
            </span>
        </div>
    </div>

    <!-- Right Section: Quick Action, Notifications & User Dropdown -->
    <div class="d-flex align-items-center gap-2 gap-md-3">
        
        <!-- Action Rapide Button -->
        <div class="dropdown">
            <button class="btn btn-sm btn-primary rounded-pill px-3 py-1 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-plus-circle"></i>
                <span class="d-none d-sm-inline">Créer</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2" style="min-width: 230px;">
                <li class="px-2 py-1 small text-muted text-uppercase fw-bold" style="font-size: 0.68rem;">Raccourcis de Création</li>
                <li><a class="dropdown-item py-2 rounded-3" href="/eleves/nouveau"><i class="fas fa-user-plus text-primary me-2"></i> Inscrire un élève</a></li>
                <li><a class="dropdown-item py-2 rounded-3" href="/enseignants/nouveau"><i class="fas fa-chalkboard-teacher text-success me-2"></i> Nouvel enseignant</a></li>
                <li><a class="dropdown-item py-2 rounded-3" href="/finance/paiements/nouveau"><i class="fas fa-receipt text-warning me-2"></i> Encaisser un reçu</a></li>
                <li><a class="dropdown-item py-2 rounded-3" href="/presences/pointage"><i class="fas fa-fingerprint text-info me-2"></i> Pointer présences</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item py-2 rounded-3" href="/resultats/saisie"><i class="fas fa-pen-nib text-secondary me-2"></i> Encoder des cotes</a></li>
            </ul>
        </div>

        <!-- Notifications Popover -->
        <div class="dropdown">
            <button class="btn btn-sm btn-secondary rounded-circle position-relative p-0 d-flex align-items-center justify-content-center" type="button" data-bs-toggle="dropdown" style="width: 38px; height: 38px;">
                <i class="fas fa-bell text-secondary"></i>
                <% if (stats.unread_notifications > 0) { %>
                    <span class="position-absolute top-0 end-0 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                <% } %>
            </button>
            <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2" style="width: 320px;">
                <div class="p-2 border-bottom d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-dark small">Notifications & Flux</span>
                    <span class="badge badge-figma-blue"><%= stats.unread_notifications %> non lues</span>
                </div>
                <div class="py-1">
                    <% (notifications || []).slice(0, 3).forEach(function(notif) { %>
                        <div class="p-2 rounded-3 hover-bg-light border-bottom border-light">
                            <div class="small fw-semibold text-<%= notif.type === 'success' ? 'success' : notif.type === 'warning' ? 'warning' : 'primary' %>">
                                <%= notif.titre %>
                            </div>
                            <div class="text-muted text-truncate" style="font-size: 0.78rem;"><%= notif.message %></div>
                            <div class="text-secondary mt-1" style="font-size: 0.68rem;"><%= notif.date_creation %></div>
                        </div>
                    <% }); %>
                </div>
                <div class="p-1 text-center">
                    <a href="/communication" class="small text-primary text-decoration-none fw-semibold">Accéder au centre d'alertes &rarr;</a>
                </div>
            </div>
        </div>

        <!-- User Profile Pill -->
        <div class="dropdown">
            <button class="btn btn-sm btn-secondary d-flex align-items-center gap-2 rounded-pill px-2 py-1" type="button" data-bs-toggle="dropdown">
                <div class="avatar-placeholder" style="width: 28px; height: 28px; font-size: 0.75rem; border-radius: 8px;">
                    <%= user.first_name[0] %><%= user.last_name[0] %>
                </div>
                <span class="d-none d-md-inline fw-semibold text-dark small"><%= user.first_name %></span>
                <i class="fas fa-chevron-down text-muted" style="font-size: 0.65rem;"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2" style="min-width: 220px;">
                <li class="px-3 py-2 border-bottom">
                    <div class="fw-bold text-dark"><%= user.first_name %> <%= user.last_name %></div>
                    <div class="small text-muted text-truncate"><%= user.email %></div>
                </li>
                <li><a class="dropdown-item py-2 rounded-3 mt-1" href="/accounts/profile"><i class="fas fa-user-circle text-muted me-2"></i> Mon Profil</a></li>
                <li><a class="dropdown-item py-2 rounded-3" href="/parametres"><i class="fas fa-sliders-h text-muted me-2"></i> Paramètres École</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item py-2 rounded-3 text-danger" href="/accounts/logout"><i class="fas fa-sign-out-alt me-2"></i> Déconnexion</a></li>
            </ul>
        </div>
    </div>
</header>
