<aside class="sidebar-wrapper" id="sidebar-wrapper">
    <!-- Brand Card Header -->
    <div class="sidebar-brand-card">
        <div class="d-flex align-items-center gap-3">
            <div class="brand-icon-box">
                <i class="fas fa-layer-group fs-5"></i>
            </div>
            <div>
                <div class="fw-bold text-white fs-6 d-flex align-items-center gap-2">
                    EXCELLENCE
                    <span class="badge bg-primary bg-opacity-25 text-info border border-info border-opacity-25" style="font-size: 0.65rem;">RDC</span>
                </div>
                <div class="small text-secondary" style="font-size: 0.72rem;">Portail Scolaire Intégré</div>
            </div>
        </div>
    </div>

    <!-- Navigation Scroll Area -->
    <div class="py-2 flex-grow-1">
        <!-- Main Dashboard -->
        <a href="/" class="figma-nav-item <%= currentPath === '/' ? 'active' : '' %>" id="nav-dashboard">
            <i class="fas fa-shapes figma-nav-icon"></i>
            <span>Tableau de Bord</span>
        </a>

        <!-- Section Académique -->
        <div class="sidebar-section-title">
            <span>Académique</span>
            <i class="fas fa-chevron-right text-muted" style="font-size: 0.55rem;"></i>
        </div>

        <a href="/eleves" class="figma-nav-item <%= currentPath.startsWith('/eleves') ? 'active' : '' %>" id="nav-eleves">
            <i class="fas fa-user-graduate figma-nav-icon"></i>
            <span>Élèves</span>
            <span class="figma-nav-pill badge-figma-blue"><%= stats.total_eleves %></span>
        </a>

        <a href="/enseignants" class="figma-nav-item <%= currentPath.startsWith('/enseignants') ? 'active' : '' %>" id="nav-enseignants">
            <i class="fas fa-chalkboard-teacher figma-nav-icon"></i>
            <span>Enseignants</span>
            <span class="figma-nav-pill badge-figma-emerald"><%= stats.total_enseignants %></span>
        </a>

        <a href="/classes" class="figma-nav-item <%= currentPath.startsWith('/classes') ? 'active' : '' %>" id="nav-classes">
            <i class="fas fa-cubes figma-nav-icon"></i>
            <span>Classes & Salles</span>
            <span class="figma-nav-pill badge-figma-purple"><%= stats.total_classes %></span>
        </a>

        <a href="/cours" class="figma-nav-item <%= currentPath.startsWith('/cours') ? 'active' : '' %>" id="nav-cours">
            <i class="fas fa-book-open figma-nav-icon"></i>
            <span>Cours & Matières</span>
            <span class="figma-nav-pill badge-figma-amber"><%= stats.total_cours %></span>
        </a>

        <a href="/horaires" class="figma-nav-item <%= currentPath.startsWith('/horaires') ? 'active' : '' %>" id="nav-horaires">
            <i class="fas fa-calendar-alt figma-nav-icon"></i>
            <span>Emploi du Temps</span>
        </a>

        <!-- Section Suivi & Délibération -->
        <div class="sidebar-section-title">
            <span>Suivi & Évaluation</span>
            <i class="fas fa-chevron-right text-muted" style="font-size: 0.55rem;"></i>
        </div>

        <a href="/presences" class="figma-nav-item <%= currentPath.startsWith('/presences') ? 'active' : '' %>" id="nav-presences">
            <i class="fas fa-fingerprint figma-nav-icon"></i>
            <span>Présences Journalières</span>
            <span class="figma-nav-pill badge-figma-emerald"><%= stats.presenceRate %>%</span>
        </a>

        <a href="/discipline" class="figma-nav-item <%= currentPath.startsWith('/discipline') ? 'active' : '' %>" id="nav-discipline">
            <i class="fas fa-shield-alt figma-nav-icon"></i>
            <span>Discipline</span>
            <% if (stats.total_incidents_actifs > 0) { %>
                <span class="figma-nav-pill badge-figma-rose"><%= stats.total_incidents_actifs %></span>
            <% } %>
        </a>

        <a href="/resultats" class="figma-nav-item <%= currentPath.startsWith('/resultats') ? 'active' : '' %>" id="nav-resultats">
            <i class="fas fa-award figma-nav-icon"></i>
            <span>Bulletins & Cotes</span>
        </a>

        <!-- Section Trésorerie -->
        <div class="sidebar-section-title">
            <span>Finance & Trésorerie</span>
            <i class="fas fa-chevron-right text-muted" style="font-size: 0.55rem;"></i>
        </div>

        <a href="/finance" class="figma-nav-item <%= currentPath.startsWith('/finance') ? 'active' : '' %>" id="nav-finance">
            <i class="fas fa-wallet figma-nav-icon"></i>
            <span>Comptabilité & Caisse</span>
        </a>

        <!-- Section Espace Parents & Connectivité -->
        <div class="sidebar-section-title">
            <span>Système & Portail</span>
            <i class="fas fa-chevron-right text-muted" style="font-size: 0.55rem;"></i>
        </div>

        <a href="/parents" class="figma-nav-item <%= currentPath.startsWith('/parents') ? 'active' : '' %>" id="nav-parents">
            <i class="fas fa-users-viewfinder figma-nav-icon"></i>
            <span>Espace Parents</span>
        </a>

        <a href="/communication" class="figma-nav-item <%= currentPath.startsWith('/communication') ? 'active' : '' %>" id="nav-communication">
            <i class="fas fa-paper-plane figma-nav-icon"></i>
            <span>Messagerie & Alertes</span>
            <% if (stats.unread_messages > 0) { %>
                <span class="figma-nav-pill badge-figma-blue"><%= stats.unread_messages %></span>
            <% } %>
        </a>

        <a href="/parametres" class="figma-nav-item <%= currentPath.startsWith('/parametres') ? 'active' : '' %>" id="nav-parametres">
            <i class="fas fa-sliders-h figma-nav-icon"></i>
            <span>Configuration</span>
        </a>
    </div>

    <!-- Bottom User Footer -->
    <div class="sidebar-user-footer">
        <a href="/accounts/profile" class="sidebar-user-pill">
            <div class="avatar-placeholder me-2" style="width: 32px; height: 32px; font-size: 0.78rem;">
                <%= user.first_name[0] %><%= user.last_name[0] %>
            </div>
            <div class="overflow-hidden me-auto">
                <div class="text-white fw-semibold text-truncate small"><%= user.first_name %> <%= user.last_name %></div>
                <div class="text-secondary small d-flex align-items-center gap-1" style="font-size: 0.7rem;">
                    <span class="badge-dot bg-success"></span> <%= user.role %>
                </div>
            </div>
            <i class="fas fa-ellipsis-v text-secondary small"></i>
        </a>
    </div>
</aside>
