<%- include('../layout/header', { title: 'Discipline et Conduite - Gestion Scolaire RDC' }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="fas fa-gavel text-danger me-2"></i> Discipline & Conduite Scolaire</h3>
        <p class="text-muted small mb-0">Registre des incidents, conseils de discipline, sanctions et avertissements</p>
    </div>
    <div>
        <a href="/discipline/nouveau" class="btn btn-danger rounded-pill px-4 shadow-sm">
            <i class="fas fa-exclamation-triangle me-2"></i> Signaler un incident
        </a>
    </div>
</div>

<div class="card border-0 rounded-4 shadow-sm p-4">
    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Élève Concerné</th>
                    <th>Type d'Incident</th>
                    <th>Description des faits</th>
                    <th>Sanction Appliquée</th>
                    <th>Rapporteur</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                <% if (incidents.length === 0) { %>
                    <tr><td colspan="7" class="text-center py-5 text-muted">Aucun incident disciplinaire consigné.</td></tr>
                <% } %>
                <% incidents.forEach(function(inc) { 
                    const el = eleves.find(e => e.id === inc.eleve_id);
                %>
                <tr>
                    <td><strong><%= inc.date %></strong></td>
                    <td>
                        <div class="d-flex align-items-center">
                            <% if (el && el.photo) { %>
                                <img src="<%= el.photo %>" class="student-avatar me-2" alt="Photo">
                            <% } else { %>
                                <div class="avatar-placeholder me-2"><%= el ? el.nom[0] + el.prenom[0] : 'EL' %></div>
                            <% } %>
                            <div>
                                <strong class="text-dark"><%= el ? el.nom + ' ' + el.prenom : 'Élève' %></strong>
                                <div class="small text-muted"><%= el ? el.matricule : '' %></div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="badge <%= inc.type === 'avertissement' ? 'bg-warning text-dark' : inc.type === 'blâme' ? 'bg-danger' : 'bg-dark' %> text-uppercase">
                            <%= inc.type %>
                        </span>
                    </td>
                    <td class="small" style="max-width: 250px;"><%= inc.description %></td>
                    <td class="small fw-semibold text-danger"><%= inc.sanction %></td>
                    <td class="small text-muted"><%= inc.rapporte_par %></td>
                    <td>
                        <% if (inc.date_cloture) { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Clôturé le <%= inc.date_cloture %></span>
                        <% } else { %>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">En cours</span>
                        <% } %>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../layout/footer') %>
