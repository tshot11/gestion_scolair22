<%- include('../layout/header', { title: 'Portail Parents - Gestion Scolaire RDC' }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="fas fa-user-friends text-primary me-2"></i> Espace Numérique Parents & Tuteurs</h3>
        <p class="text-muted small mb-0">Suivi direct des résultats, ponctualité, paiements et bulletins de vos enfants</p>
    </div>
</div>

<div class="row g-4">
    <% eleves.forEach(function(el) { 
        const detail = getEleveDetail(el.id);
    %>
    <div class="col-xl-6">
        <div class="card border-0 rounded-4 shadow-sm p-4 h-100">
            <div class="d-flex align-items-center mb-3">
                <% if (el.photo) { %>
                    <img src="<%= el.photo %>" class="student-avatar me-3" style="width: 60px; height: 60px;" alt="Photo">
                <% } else { %>
                    <div class="avatar-placeholder me-3 bg-primary text-white" style="width: 60px; height: 60px; font-size: 1.2rem;">
                        <%= el.nom[0] %><%= el.prenom[0] %>
                    </div>
                <% } %>
                <div>
                    <h5 class="fw-bold mb-0 text-dark"><%= el.nom %> <%= el.prenom %></h5>
                    <span class="badge bg-light text-dark border font-monospace"><%= el.matricule %></span>
                    <span class="badge bg-primary-subtle text-primary"><%= detail.classe ? detail.classe.nom : 'Classe' %></span>
                </div>
            </div>

            <div class="row g-2 mb-3 text-center">
                <div class="col-4">
                    <div class="p-2 bg-light rounded-3">
                        <small class="text-muted d-block" style="font-size: 0.75rem;">Moyenne 3e P.</small>
                        <strong class="text-primary fs-5"><%= detail.moyenne %>/20</strong>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 bg-light rounded-3">
                        <small class="text-muted d-block" style="font-size: 0.75rem;">Pourcentage</small>
                        <strong class="text-success fs-5"><%= detail.pourcentage %>%</strong>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 bg-light rounded-3">
                        <small class="text-muted d-block" style="font-size: 0.75rem;">Discipline</small>
                        <strong class="text-dark fs-5"><%= detail.incidents.length === 0 ? 'Excellente' : detail.incidents.length + ' avert.' %></strong>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-auto">
                <span class="small text-muted"><i class="fas fa-calendar-check text-success me-1"></i> Présences à jour</span>
                <div class="d-flex gap-2">
                    <a href="/eleves/<%= el.id %>" class="btn btn-sm btn-outline-primary rounded-pill px-3">Dossier</a>
                    <a href="/resultats/bulletin/<%= el.id %>" class="btn btn-sm btn-success rounded-pill px-3">Bulletin</a>
                </div>
            </div>
        </div>
    </div>
    <% }); %>
</div>

<%- include('../layout/footer') %>
