<%- include('../layout/header', { title: 'Détail de la Classe - ' + classe.nom }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/classes" class="text-decoration-none">Classes</a></li>
                <li class="breadcrumb-item active"><%= classe.nom %></li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0">Classe : <%= classe.nom %></h3>
    </div>
    <div class="d-flex gap-2">
        <a href="/eleves/nouveau?classe_id=<%= classe.id %>" class="btn btn-primary rounded-pill px-3">
            <i class="fas fa-user-plus me-1"></i> Inscrire un élève dans cette classe
        </a>
        <a href="/classes" class="btn btn-light rounded-pill px-3">
            <i class="fas fa-arrow-left me-1"></i> Retour
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card border-0 rounded-4 shadow-sm p-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2">Informations Générales</h5>
            <div class="mb-2"><strong>Nom de la classe :</strong> <%= classe.nom %></div>
            <div class="mb-2"><strong>Titulaire :</strong> <%= prof ? prof.nom + ' ' + prof.prenom : 'Non affecté' %></div>
            <div class="mb-2"><strong>Salle attitrée :</strong> <%= salle ? salle.nom : 'Non définie' %></div>
            <div class="mb-2"><strong>Capacité maximale :</strong> <%= classe.capacite %> élèves</div>
            <div class="mb-2"><strong>Effectif actuel :</strong> <%= eleves.length %> élèves</div>
            <div class="mb-2"><strong>Places disponibles :</strong> <%= Math.max(0, classe.capacite - eleves.length) %> places</div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 rounded-4 shadow-sm p-4">
            <h5 class="fw-bold mb-3 d-flex justify-content-between align-items-center">
                <span><i class="fas fa-users text-primary me-2"></i> Liste des Élèves Inscrits (<%= eleves.length %>)</span>
                <button class="btn btn-sm btn-outline-secondary rounded-pill" onclick="window.print()"><i class="fas fa-print me-1"></i> Imprimer</button>
            </h5>
            <div class="table-responsive">
                <table class="table table-hover table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Élève</th>
                            <th>Matricule</th>
                            <th>Sexe</th>
                            <th>Contact Parent</th>
                            <th class="text-end">Fiche</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (eleves.length === 0) { %>
                            <tr><td colspan="6" class="text-center py-4 text-muted">Aucun élève inscrit dans cette classe pour le moment.</td></tr>
                        <% } %>
                        <% eleves.forEach(function(el, idx) { %>
                        <tr>
                            <td><%= idx + 1 %></td>
                            <td>
                                <strong><%= el.nom %> <%= el.prenom %></strong>
                            </td>
                            <td><span class="badge bg-light text-dark border font-monospace"><%= el.matricule %></span></td>
                            <td><%= el.sexe === 'M' ? 'M' : 'F' %></td>
                            <td><small><%= el.telephone || el.email_parent || 'N/A' %></small></td>
                            <td class="text-end">
                                <a href="/eleves/<%= el.id %>" class="btn btn-sm btn-outline-primary rounded-pill py-0 px-2">Voir</a>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
