<%- include('../layout/header', { title: 'Classes et Salles - Gestion Scolaire RDC' }) %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="fas fa-door-open text-info me-2"></i> Classes & Salles de Cours</h3>
        <p class="text-muted small mb-0">Gestion des structures de classes, capacités d'accueil et salles</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/classes/nouveau" class="btn btn-info text-white rounded-pill px-4 shadow-sm">
            <i class="fas fa-plus me-2"></i> Nouvelle Classe
        </a>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-12">
        <h5 class="fw-bold text-dark mb-3"><i class="fas fa-chalkboard text-primary me-2"></i> Liste des Classes de l'Établissement</h5>
    </div>
    <% classes.forEach(function(cl) { 
        const elevesClasse = eleves.filter(e => e.classe_id === cl.id);
        const prof = enseignants.find(ens => ens.id === cl.prof_id);
        const salle = salles.find(s => s.id === cl.salle_id);
        const percent = Math.min(100, Math.round((elevesClasse.length / cl.capacite) * 100));
    %>
    <div class="col-xl-4 col-md-6">
        <div class="card border-0 rounded-4 shadow-sm p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="fw-bold text-dark mb-1"><%= cl.nom %></h5>
                    <span class="badge bg-light text-muted border font-monospace">Capacité : <%= cl.capacite %> places</span>
                </div>
                <div class="p-3 bg-info bg-opacity-10 text-info rounded-circle">
                    <i class="fas fa-door-open fa-lg"></i>
                </div>
            </div>

            <div class="mb-3 small">
                <div class="text-muted mb-1"><i class="fas fa-user-tie text-info me-2"></i><strong>Titulaire :</strong> <%= prof ? prof.nom + ' ' + prof.prenom : 'Non affecté' %></div>
                <div class="text-muted mb-1"><i class="fas fa-map-marker-alt text-info me-2"></i><strong>Salle attitrée :</strong> <%= salle ? salle.nom : 'Non définie' %></div>
            </div>

            <div class="mt-auto">
                <div class="d-flex justify-content-between align-items-center small mb-1">
                    <span class="text-muted">Effectif : <strong><%= elevesClasse.length %></strong> élèves inscrits</span>
                    <span class="fw-bold <%= percent > 85 ? 'text-danger' : 'text-success' %>"><%= percent %>%</span>
                </div>
                <div class="progress mb-3" style="height: 6px;">
                    <div class="progress-bar <%= percent > 85 ? 'bg-danger' : 'bg-info' %>" style="width: <%= percent %>%"></div>
                </div>
                <div class="d-flex justify-content-end">
                    <a href="/classes/<%= cl.id %>" class="btn btn-sm btn-outline-info rounded-pill px-3">
                        <i class="fas fa-list me-1"></i> Fiche & Élèves
                    </a>
                </div>
            </div>
        </div>
    </div>
    <% }); %>
</div>

<!-- Section Salles -->
<div class="row g-4">
    <div class="col-12">
        <div class="card border-0 rounded-4 shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="fas fa-building text-warning me-2"></i> Inventaire des Salles & Laboratoires</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Nom de la Salle</th>
                            <th>Capacité</th>
                            <th>Équipements</th>
                            <th>Disponibilité</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% salles.forEach(function(s) { %>
                        <tr>
                            <td><span class="badge bg-light text-dark border font-monospace"><%= s.code %></span></td>
                            <td><strong><%= s.nom %></strong></td>
                            <td><%= s.capacite %> places assises</td>
                            <td class="small text-muted"><%= s.equipement || 'Standard' %></td>
                            <td>
                                <span class="badge <%= s.disponible ? 'bg-success' : 'bg-danger' %>">
                                    <%= s.disponible ? 'Disponible' : 'Occupée' %>
                                </span>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
