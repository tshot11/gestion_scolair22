<%- include('../layout/header', { title: (eleve ? 'Modifier l’élève' : 'Nouvel élève') + ' - Gestion Scolaire RDC' }) %>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/eleves" class="text-decoration-none">Élèves</a></li>
                        <li class="breadcrumb-item active"><%= eleve ? 'Modification' : 'Inscription' %></li>
                    </ol>
                </nav>
                <h3 class="fw-bold mb-0">
                    <i class="fas <%= eleve ? 'fa-user-edit text-warning' : 'fa-user-plus text-primary' %> me-2"></i>
                    <%= eleve ? 'Modifier le dossier de l’élève' : 'Formulaire d’inscription d’un nouvel élève' %>
                </h3>
            </div>
            <a href="/eleves" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="fas fa-arrow-left me-1"></i> Retour à la liste
            </a>
        </div>

        <div class="card border-0 rounded-4 shadow-sm p-4">
            <form action="<%= eleve ? '/eleves/' + eleve.id + '/modifier' : '/eleves/nouveau' %>" method="POST" enctype="multipart/form-data">
                
                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">1. Identité de l'Élève</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Nom de famille <span class="text-danger">*</span></label>
                        <input type="text" name="nom" class="form-control" value="<%= eleve ? eleve.nom : '' %>" placeholder="Ex: KALALA" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Prénom(s) <span class="text-danger">*</span></label>
                        <input type="text" name="prenom" class="form-control" value="<%= eleve ? eleve.prenom : '' %>" placeholder="Ex: Josué" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Sexe <span class="text-danger">*</span></label>
                        <select name="sexe" class="form-select" required>
                            <option value="M" <%= eleve && eleve.sexe === 'M' ? 'selected' : '' %>>Masculin</option>
                            <option value="F" <%= eleve && eleve.sexe === 'F' ? 'selected' : '' %>>Féminin</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Date de naissance <span class="text-danger">*</span></label>
                        <input type="date" name="date_naissance" class="form-control" value="<%= eleve ? eleve.date_naissance : '2010-01-01' %>" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Lieu de naissance <span class="text-danger">*</span></label>
                        <input type="text" name="lieu_naissance" class="form-control" value="<%= eleve ? eleve.lieu_naissance : 'Kinshasa' %>" placeholder="Ex: Kinshasa" required>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Adresse résidentielle</label>
                        <input type="text" name="adresse" class="form-control" value="<%= eleve ? eleve.adresse : '' %>" placeholder="Ex: 12 Av. du Livre, Gombe, Kinshasa">
                    </div>
                </div>

                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">2. Affectation Pédagogique</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Classe d'inscription <span class="text-danger">*</span></label>
                        <select name="classe_id" class="form-select" required>
                            <% classes.forEach(function(c) { %>
                                <option value="<%= c.id %>" <%= eleve && eleve.classe_id == c.id ? 'selected' : '' %>><%= c.nom %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Photo de l'élève (Optionnel)</label>
                        <input type="file" name="photo" class="form-control" accept="image/*">
                    </div>
                </div>

                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">3. Coordonnées des Parents / Tuteurs</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Téléphone de contact</label>
                        <input type="text" name="telephone" class="form-control" value="<%= eleve ? eleve.telephone : '' %>" placeholder="+243 81 000 0000">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Email du parent / tuteur</label>
                        <input type="email" name="email_parent" class="form-control" value="<%= eleve ? eleve.email_parent : '' %>" placeholder="parent@gmail.com">
                    </div>
                </div>

                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">4. Statut Social & Exonérations</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="est_boursier" value="true" id="boursier" <%= eleve && eleve.est_boursier ? 'checked' : '' %>>
                            <label class="form-check-label fw-semibold" for="boursier">Élève Boursier (Exonéré)</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="est_orphelin" value="true" id="orphelin" <%= eleve && eleve.est_orphelin ? 'checked' : '' %>>
                            <label class="form-check-label fw-semibold" for="orphelin">Orphelin de père ou de mère</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="est_pris_en_charge" value="true" id="pec" <%= eleve && eleve.est_pris_en_charge ? 'checked' : '' %>>
                            <label class="form-check-label fw-semibold" for="pec">Pris en charge spéciale</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 border-top pt-4">
                    <a href="/eleves" class="btn btn-light rounded-pill px-4">Annuler</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm fw-semibold">
                        <i class="fas fa-save me-2"></i> Enregistrer l'élève
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
